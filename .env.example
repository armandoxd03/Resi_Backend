PORT=5000
MONGODB_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/YourDatabase?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here

# Email Configuration
# -------------- SendGrid (Recommended for production) --------------
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM=ResiLinked <your-email@example.com>

# -------------- Gmail SMTP (Fallback) --------------
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your_app_password_here

# URLs
CLIENT_URL=http://localhost:5173,https://your-production-url.vercel.app
FRONTEND_URL=http://localhost:5173,https://your-production-url.vercel.app

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# CORS and upload settings
CORS_ENABLED=true
USE_MEMORY_STORAGE=false
CORS_DEBUG=false