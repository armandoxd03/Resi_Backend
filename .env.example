# Server Configuration
PORT=5000

# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Secret (use a strong random string)
JWT_SECRET=your_jwt_secret_here

# Email Configuration
EMAIL_SERVICE=gmail
# Gmail account username
EMAIL_USER=your-email@gmail.com
# Gmail App Password (NOT your regular Gmail password)
# To create an App Password:
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Select "App" and "Other (Custom name)" and generate a new app password
# 4. Use that password here
EMAIL_PASS=your-gmail-app-password

# Frontend URLs (comma-separated)
CLIENT_URL=http://localhost:5173,https://your-production-frontend-url
FRONTEND_URL=http://localhost:5173,https://your-production-frontend-url

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5