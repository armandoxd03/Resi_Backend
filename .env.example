# Server Configuration
PORT=5000

# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Secret (use a strong random string)
JWT_SECRET=your_jwt_secret_here

# SendGrid Email Configuration (Recommended)
# Get your API key from https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here
# The email address that will be shown as the sender
EMAIL_FROM=ResiLinked <noreply@yourdomain.com>

# Alternative Gmail Configuration (not recommended for production)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# Frontend URLs (comma-separated)
CLIENT_URL=http://localhost:5173,https://your-production-frontend-url
FRONTEND_URL=http://localhost:5173,https://your-production-frontend-url

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5