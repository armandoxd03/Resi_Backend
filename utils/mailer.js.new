const sgMail = require('@sendgrid/mail');
const nodemailer = require('nodemailer');
require('dotenv').config();

// Initialize SendGrid with API key
if (process.env.SENDGRID_API_KEY) {
  sgMail.setApiKey(process.env.SENDGRID_API_KEY);
}

/**
 * Sends verification email to new users
 * @param {string} email - User email address
 * @param {string} token - Verification token
 */
const sendVerificationEmail = async (email, token) => {
  try {
    // Get the first URL if multiple are provided (comma-separated)
    const frontendUrl = process.env.FRONTEND_URL.split(",")[0].trim();
    const verificationLink = `${frontendUrl}/verify-email/${token}`;
    
    const emailContent = {
      to: email,
      from: process.env.EMAIL_FROM || 'ResiLinked <noreply@resilinked.com>',
      subject: "Verify Your ResiLinked Account",
      text: `Welcome to ResiLinked! Please verify your email address by visiting: ${verificationLink}`,
      html: `
        <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
          <h2 style="color: #0066ee;">Welcome to ResiLinked!</h2>
          <p>Please verify your email address to complete your registration:</p>
          <a href="${verificationLink}" 
             style="display: inline-block; background: #0066ee; color: white; 
                    padding: 10px 20px; text-decoration: none; border-radius: 5px;
                    margin: 15px 0;">
            Verify Email Address
          </a>
          <p>This link will expire in 24 hours.</p>
          <p>If you didn't create this account, please ignore this email.</p>
          <p>Alternatively, you can copy and paste this link into your browser:</p>
          <p style="word-break: break-all;">${verificationLink}</p>
        </div>
      `
    };

    // Try sending with SendGrid first
    let sent = false;
    let error = null;

    if (process.env.SENDGRID_API_KEY) {
      try {
        await sgMail.send(emailContent);
        console.log(`✅ Verification email sent to ${email} via SendGrid`);
        sent = true;
      } catch (err) {
        console.error('❌ SendGrid verification email failed:', err.message);
        error = err;
      }
    }

    // If SendGrid fails or is not configured, try with Nodemailer
    if (!sent && process.env.EMAIL_USER && process.env.EMAIL_PASS) {
      try {
        // Create a nodemailer transporter as fallback
        const transporter = nodemailer.createTransport({
          host: 'smtp.gmail.com',
          port: 587,
          secure: false,
          auth: {
            user: process.env.EMAIL_USER,
            pass: process.env.EMAIL_PASS
          }
        });
        
        await transporter.sendMail(emailContent);
        console.log(`✅ Verification email sent to ${email} via Nodemailer`);
        sent = true;
      } catch (err) {
        console.error('❌ Nodemailer verification email failed:', err.message);
        error = error || err;
      }
    }

    // Check if sending was successful
    if (!sent) {
      console.error('❌ All email sending methods failed');
      throw error || new Error('Failed to send verification email');
    }
    
  } catch (error) {
    console.error("❌ Verification email error:", error.message);
    throw new Error("Failed to send verification email");
  }
};

/**
 * Sends password reset email
 * @param {string} to - Recipient email
 * @param {string} resetLink - Password reset link
 */
const sendResetEmail = async (to, resetLink) => {
  try {
    // Get the first URL if multiple are provided (comma-separated)
    const frontendUrl = process.env.FRONTEND_URL.split(",")[0].trim();
    // If resetLink doesn't have a full URL, add the frontend URL
    if (!resetLink.startsWith('http')) {
      resetLink = `${frontendUrl}${resetLink.startsWith('/') ? '' : '/'}${resetLink}`;
    }
    
    const emailContent = {
      to: to,
      from: process.env.EMAIL_FROM || 'ResiLinked <noreply@resilinked.com>',
      subject: "ResiLinked Password Reset",
      text: `You requested a password reset for your ResiLinked account. Visit the following link to reset your password: ${resetLink}`,
      html: `
        <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
          <h2 style="color: #0066ee;">Password Reset Request</h2>
          <p>Click the button below to reset your password:</p>
          <a href="${resetLink}" 
             style="display: inline-block; background: #ff6600; color: white; 
                    padding: 10px 20px; text-decoration: none; border-radius: 5px;
                    margin: 15px 0;">
            Reset Password
          </a>
          <p>This link will expire in 30 minutes.</p>
          <p>If you did not request a password reset, please ignore this email.</p>
          <p>Alternatively, you can copy and paste this link into your browser:</p>
          <p style="word-break: break-all;">${resetLink}</p>
        </div>
      `
    };

    // Try sending with SendGrid first
    let sent = false;
    let error = null;

    if (process.env.SENDGRID_API_KEY) {
      try {
        await sgMail.send(emailContent);
        console.log(`✅ Password reset email sent to ${to} via SendGrid`);
        sent = true;
      } catch (err) {
        console.error('❌ SendGrid password reset email failed:', err.message);
        error = err;
      }
    }

    // If SendGrid fails or is not configured, try with Nodemailer
    if (!sent && process.env.EMAIL_USER && process.env.EMAIL_PASS) {
      try {
        // Create a nodemailer transporter as fallback
        const transporter = nodemailer.createTransport({
          host: 'smtp.gmail.com',
          port: 587,
          secure: false,
          auth: {
            user: process.env.EMAIL_USER,
            pass: process.env.EMAIL_PASS
          }
        });
        
        await transporter.sendMail(emailContent);
        console.log(`✅ Password reset email sent to ${to} via Nodemailer`);
        sent = true;
      } catch (err) {
        console.error('❌ Nodemailer password reset email failed:', err.message);
        error = error || err;
      }
    }

    // Check if sending was successful
    if (!sent) {
      console.error('❌ All email sending methods failed');
      throw error || new Error('Failed to send password reset email');
    }
    
  } catch (error) {
    console.error("❌ Password reset email error:", error.message);
    throw new Error("Failed to send password reset email");
  }
};

// Verify email configuration
const verifyConnection = async () => {
  try {
    if (process.env.SENDGRID_API_KEY) {
      console.log("✅ SendGrid API key is configured");
      return true;
    } else if (process.env.EMAIL_USER && process.env.EMAIL_PASS) {
      console.log("✅ SMTP credentials are configured (fallback)");
      return true;
    } else {
      console.warn("⚠️ No email configuration found");
      return false;
    }
  } catch (error) {
    console.error("❌ Email configuration verification failed:", error.message);
    return false;
  }
};

// Verify connection on module import
verifyConnection();

module.exports = {
  sendVerificationEmail,
  sendResetEmail,
  verifyConnection
};